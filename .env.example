# Local-only infrastructure defaults. Change credentials before exposing any port
# beyond 127.0.0.1.
POSTGRES_DB=salmon_mind
POSTGRES_USER=salmon_mind
POSTGRES_PASSWORD=salmon_mind_local
POSTGRES_PORT=5432

ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

RUSTFS_ACCESS_KEY=salmonmind
RUSTFS_SECRET_KEY=salmonmind-local-change-me
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET_KNOWLEDGE=salmon-knowledge

SERVER_PORT=8080
JAVA_OPTS=

# OpenAI-compatible endpoints. Base URLs must end before /chat/completions or
# /embeddings; for example, https://api.example.com/v1.
MODEL_CHAT_BASE_URL=
MODEL_CHAT_API_KEY=
MODEL_CHAT_NAME=
MODEL_EMBEDDING_BASE_URL=
MODEL_EMBEDDING_API_KEY=
MODEL_EMBEDDING_NAME=
